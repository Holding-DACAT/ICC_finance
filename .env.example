# =====================================================================
#  GESTION RH — ICC Finance · Variables d'environnement (exemple)
#  Copier ce fichier en `.env` (local) et renseigner les valeurs.
#  NE JAMAIS committer de secrets réels.
# =====================================================================

# --- Base de données PostgreSQL (Neon) -------------------------------
# Connexion POOLED (hôte en "-pooler") — utilisée par le runtime Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Connexion DIRECTE — utilisée par les migrations Prisma.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# --- Authentification (Clerk) ----------------------------------------
# Clés du projet Clerk (Dashboard Clerk → API Keys).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
# URLs des écrans d'auth (déjà câblées dans l'app).
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"
# Rôles : définis dans Clerk via le publicMetadata de chaque utilisateur, ex.
#   { "role": "ADMIN", "scopedAgencyId": null }
# Rôles possibles : ADMIN | RH | IT | BACK_OFFICE | DIRECTEUR_AGENCE | LECTURE
# (BACK_OFFICE : suivi des apporteurs d'affaires — conventions et ristournes).
# (DIRECTEUR_AGENCE : renseigner scopedAgencyId avec l'id de son agence).

# --- Intégrations (Microsoft Graph, SharePoint, mail) ----------------
# true = utiliser les implémentations MOCK (aucun appel réseau réel).
# Vaut aussi pour l'intégration Actelo (pilotage commercial) : tant que
# USE_INTEGRATION_MOCKS=true OU qu'ACTELO_API_TOKEN est absent, on utilise le mock.
USE_INTEGRATION_MOCKS="true"

# --- Actelo (pilotage commercial — API api.actelo.fr) ----------------
# Jeton d'accès Actelo (NE JAMAIS committer la vraie valeur). Une fois renseigné
# et USE_INTEGRATION_MOCKS=false, le dashboard /pilotage interroge l'API réelle.
ACTELO_API_TOKEN=""
# Schéma d'authentification. Actelo attend le token BRUT dans l'en-tête
# Authorization (sans "Bearer "). Configuration confirmée :
ACTELO_AUTH_HEADER="Authorization"
ACTELO_AUTH_PREFIX="none"   # "none"/"vide" = aucun préfixe (envoie "Authorization: <token>")
# Optionnel : ACTELO_API_BASE_URL="https://api.actelo.fr"

# --- Tâches planifiées (Vercel Cron) + route de seed protégée --------
# Secret partagé : les endpoints /api/cron/* et /api/admin/seed le vérifient.
CRON_SECRET="remplacer-par-un-secret-genere"
